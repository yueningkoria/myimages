{
  "version": 4,
  "configurations": [
    {
      "name": "MinGW-w64 (gcc)",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "_DEBUG",
        "UNICODE",
        "_UNICODE"
      ],
      "compilerPath": "C:/mingw64/bin/gcc.exe",
      "compilerArgs": [
        "-Wall",
        "-Wextra"
      ],
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64"
    }
  ]
}
