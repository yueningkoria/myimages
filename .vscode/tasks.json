{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gcc: 编译当前文件（调试版）",
      "type": "shell",
      "command": "C:\\mingw64\\bin\\gcc.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g3",
        "-Wall",
        "-Wextra",
        "-fexec-charset=UTF-8",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "gcc -g3 -Wall -Wextra ：带调试信息，F5 调试前会自动执行"
    },
    {
      "label": "gcc: 编译当前文件（发布版 -O2）",
      "type": "shell",
      "command": "C:\\mingw64\\bin\\gcc.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-O2",
        "-Wall",
        "-Wextra",
        "-fexec-charset=UTF-8",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "gcc -O2 ：优化编译，用于最终发布"
    },
    {
      "label": "gcc: 编译并运行当前文件",
      "type": "shell",
      "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "options": {
        "cwd": "${fileDirname}"
      },
      "dependsOn": "gcc: 编译当前文件（调试版）",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "detail": "先编译，再直接在终端里运行（快捷键 Ctrl+Shift+P → Tasks: Run Test Task）"
    }
  ]
}
